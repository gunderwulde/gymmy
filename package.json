{
  "name": "gymmy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"*.ts\" \"test/**/*.ts\" \"index.html\" \"styles.css\" \"README.md\" \"package.json\" \"tsconfig*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"*.ts\" \"test/**/*.ts\" \"index.html\" \"styles.css\" \"README.md\" \"package.json\" \"tsconfig*.json\" \".github/workflows/*.yml\"",
    "typecheck": "vue-tsc -b --pretty"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  }
}
